# 只在后端设置密钥，禁止添加 VITE_ 前缀或提交 .env
LLM_MODE=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
DATABASE_PATH=data/assistant.db

# 本地 HTTP 保持 false；不代表可直接部署公网
COOKIE_SECURE=false
# 仅在修改前端端口时调整来源；精确地址，逗号分隔
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# 学生自主学习 / 个人AI练习 / 教师AI出题共用（密钥仅留在backend/.env，不提交Git）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 每名学生每天最多发起的个人AI任务数（含已发起但失败的任务），避免重复付费调用
PERSONAL_AI_DAILY_LIMIT=20
